    }
  },
  "auth": {
    "profiles": {}
  },
  "models": {
    "providers": {
      "glmcode": {
        "baseUrl": "https://open.bigmodel.cn/api/coding/paas/v4",
        "apiKey": "${GLM_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "glm-5",
            "name": "GLM-5"
          },
          {
            "id": "glm-4.7",
            "name": "GLM-4.7"
          }
        ]
      },
      "kimicode": {
        "baseUrl": "https://ark.cn-beijing.volces.com/api/coding/v3",
        "apiKey": "${KIMI_API_KEY}",
        "api": "openai-completions",
        "models": [
          {
            "id": "Doubao-Seed-2.0-pro",
            "name": "Doubao-Seed-2.0-pro"
          }
        ]
      },
      "openai-codex": {
        "baseUrl": "https://api.openai.com/v1",
        "api": "openai-completions",
        "models": [
          {
            "id": "gpt-5.5",
            "name": "GPT-5.5"
          },
          {
            "id": "gpt-5.4",
            "name": "GPT-5.4"
          },
          {
            "id": "gpt-5.4-mini",
            "name": "GPT-5.4 Mini"
          },
          {
            "id": "gpt-5.3-codex",
            "name": "GPT-5.3 Codex"
          },
          {
            "id": "gpt-5.3-codex-spark",
            "name": "GPT-5.3 Spark"
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "openai-codex/gpt-5.5",
        "fallbacks": [
          "openai-codex/gpt-5.5",
          "openai-codex/gpt-5.4",
          "kimicode/Doubao-Seed-2.0-pro",
          "glmcode/glm-5",
          "openai-codex/gpt-5.3-codex-spark",
          "glmcode/glm-4.7"
        ]
      },
      "models": {
        "kimicode/doubao-seed-2.0-pro": {
          "alias": "doubao",
          "params": {
            "thinking": "high"
          }
        },
        "kimicode/Doubao-Seed-2.0-Code": {
          "alias": "doubao-code",
          "params": {
            "thinking": "high"
          }
        },
        "openai-codex/gpt-5.5": {
          "alias": "codex55",
          "params": {
            "thinking": "high"
          }
        },
        "glmcode/glm-5": {
          "alias": "glm",
          "params": {
            "thinking": "high"
          }
        },
        "glmcode/glm-4.7": {
          "alias": "glm47",
          "params": {
            "thinking": "high"
          }
        },
        "openai-codex/gpt-5.4": {
          "alias": "codex",
          "params": {
            "thinking": "xhigh"
          }
        },
        "openai-codex/gpt-5.3-codex-spark": {
          "alias": "codex53-spark",
          "params": {
            "thinking": "xhigh"
          }
        },
        "kimicode/Doubao-Seed-2.0-pro": {
          "alias": "doubao-2.0-pro",
          "params": {
            "thinking": "high"
          }
        },
        "openai-codex/gpt-5.4-mini": {
          "alias": "codex-mini",
          "params": {
            "thinking": "high"
          }
        },
        "openai-codex/gpt-5.3-codex": {
          "alias": "codex53",
          "params": {
            "thinking": "xhigh"
          }
        }
      },
      "compaction": {
        "mode": "safeguard"
      },
      "thinkingDefault": "high",
      "timeoutSeconds": 1200,
      "maxConcurrent": 4,
      "subagents": {
        "maxConcurrent": 8,
        "maxSpawnDepth": 2,
        "maxChildrenPerAgent": 5
      }
    },
    "list": [
      {
        "id": "coordinator",
        "default": true,
        "name": "coordinator",
        "workspace": "/root/.openclaw/workspace-coordinator",
        "model": "openai-codex/gpt-5.5",
        "runtimeRole": "workflow-stage-owner",
        "subagents": {
          "allowAgents": [
            "project-agent",
            "web-agent",
            "reviewer",
            "backend-dev",
            "frontend-dev",
            "tester",
            "deployer",
            "doc-writer"
          ]
        }
      },
      {
        "id": "project-agent",
        "name": "project-agent",
        "workspace": "/root/.openclaw/workspace-project-agent",
        "agentDir": "/root/.openclaw/agents/project-agent/agent",
        "model": "openai-codex/gpt-5.5",
        "runtimeRole": "workflow-stage-owner",
        "subagents": {
          "allowAgents": [
            "web-agent",
            "reviewer"
          ]
        }
      },
      {
        "id": "web-agent",
        "name": "web-agent",
        "workspace": "/root/.openclaw/workspace-web-agent",
        "agentDir": "/root/.openclaw/agents/web-agent/agent",
        "model": "openai-codex/gpt-5.5",
        "runtimeRole": "workflow-stage-owner"
      },
      {
        "id": "reviewer",
        "name": "reviewer",
        "workspace": "/root/.openclaw/workspace-reviewer",
        "model": "openai-codex/gpt-5.5",
        "runtimeRole": "workflow-stage-owner"
      },
      {
        "id": "backend-dev",
        "name": "backend-dev",
        "workspace": "/root/.openclaw/workspace-backend-dev",
        "model": "openai-codex/gpt-5.5",
        "runtimeRole": "workflow-stage-owner"
      },
      {
        "id": "frontend-dev",
        "name": "frontend-dev",
        "workspace": "/root/.openclaw/workspace-frontend-dev",
        "agentDir": "/root/.openclaw/agents/frontend-dev/agent",
        "model": "openai-codex/gpt-5.5",
        "runtimeRole": "workflow-stage-owner"
      },
      {
        "id": "tester",
        "name": "tester",
        "workspace": "/root/.openclaw/workspace-tester",
        "model": "openai-codex/gpt-5.5",
        "runtimeRole": "workflow-stage-owner"
      },
      {
        "id": "deployer",
        "name": "deployer",
        "workspace": "/root/.openclaw/workspace-deployer",
        "model": "openai-codex/gpt-5.5",
        "runtimeRole": "workflow-stage-owner"
      },
      {
        "id": "doc-writer",
        "name": "doc-writer",
        "workspace": "/root/.openclaw/workspace-doc-writer",
        "model": "openai-codex/gpt-5.5",
        "runtimeRole": "workflow-stage-owner"
      }
    ]
  },
  "tools": {
    "alsoAllow": [
      "lobster",
      "codex"
    ],
    "agentToAgent": {
      "enabled": true,
      "allow": [
        "backend-dev",
        "coordinator",
        "deployer",
        "doc-writer",
        "frontend-dev",
        "project-agent",
        "reviewer",
        "tester",
        "web-agent"
      ]
    },
    "exec": {
      "notifyOnExit": false
    }
  },
  "bindings": [
    {
      "agentId": "coordinator",
      "match": {
        "channel": "telegram"
      }
    }
  ],
  "messages": {
    "ackReactionScope": "group-mentions"
  },
  "commands": {
    "native": "auto",
    "nativeSkills": "auto",
    "restart": true,
    "ownerDisplay": "raw"
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "hooks": {
