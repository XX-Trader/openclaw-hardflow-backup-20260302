{
  "description": "量化交易机器人项目特定的日志分析配置",

  "flow_steps": [
    {
      "name": "检测新交易",
      "pattern": "\\[MONITOR\\].*发现.*新交易"
    },
    {
      "name": "加入队列",
      "pattern": "\\[QUEUE\\].*新交易已加入队列"
    },
    {
      "name": "开始处理",
      "pattern": "\\[QUEUE\\].*开始处理队列中的交易"
    },
    {
      "name": "开始执行",
      "pattern": "\\[EXECUTE\\].*开始执行跟单"
    },
    {
      "name": "配置刷新",
      "pattern": "\\[TRADE\\].*配置已从数据库刷新"
    },
    {
      "name": "处理跟单信号",
      "pattern": "\\[TRADE\\].*开始处理跟单信号"
    },
    {
      "name": "持仓检查",
      "pattern": "\\[TRADE\\].*交易员持仓检查"
    },
    {
      "name": "下单/跳过",
      "pattern": "\\[EXECUTE\\].*跟单|下单|跳过"
    },
    {
      "name": "交易完成",
      "pattern": "\\[QUEUE\\].*交易处理完成"
    }
  ],

  "required_steps": [
    "检测新交易",
    "加入队列",
    "开始处理"
  ],

  "flow_grouping": {
    "start_pattern": "\\[QUEUE\\].*新交易已加入队列",
    "end_pattern": "交易处理完成",
    "id_pattern": "新交易已加入队列:\\s*(0x[a-f0-9]{8,})"
  },

  "consistency_checks": [
    {
      "name": "持仓缓存为空",
      "pattern": "\\[WARNING\\].*内存持仓缓存为空",
      "severity": "medium",
      "description": "持仓缓存未初始化，可能导致跟单判断错误"
    },
    {
      "name": "配置格式错误",
      "pattern": "标签 'copy_ratio' 配置格式错误",
      "severity": "high",
      "description": "配置文件中copy_ratio类型错误"
    },
    {
      "name": "API请求失败",
      "pattern": "\\[WARNING\\].*API请求失败",
      "severity": "medium",
      "description": "外部API调用失败"
    },
    {
      "name": "数据库连接问题",
      "pattern": "\\[ERROR\\].*数据库",
      "severity": "critical",
      "description": "数据库连接或查询失败"
    }
  ],

  "parameter_checks": [
    {
      "name": "余额为0警告",
      "pattern": "交易员余额.*0\\.0*\\s*USDC",
      "severity": "critical",
      "description": "交易员余额为0，无法正常跟单"
    },
    {
      "name": "配置错误",
      "pattern": "copy_ratio.*配置格式错误",
      "severity": "high",
      "description": "copy_ratio配置格式错误"
    }
  ]
}
