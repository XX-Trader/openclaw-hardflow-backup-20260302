# Copy to ~/.openclaw/hardflow/hardflow.env and edit per server.
# This file is sourced by scripts/hardflow/hardflow-run.sh on every run.

# ----------------------------
# Core execution commands
# ----------------------------
export DEPLOY_CMD='bash /home/ubuntu/Project/scripts/deploy-prod.sh'
export GIT_PUSH_CMD='git -C /home/ubuntu/Project push origin HEAD:main'

# Optional:
# export DISPATCH_CMD='bash /home/ubuntu/Project/scripts/hardflow/dispatch.sh'
# export IMPLEMENT_CMD='bash /home/ubuntu/Project/scripts/hardflow/implement.sh'
# export TEST_CMD='bash /home/ubuntu/Project/scripts/test-all.sh'
# export FIX_CMD='bash /home/ubuntu/Project/scripts/hardflow/fix-failed.sh'
# export REVIEW_CMD='bash /home/ubuntu/Project/scripts/hardflow/review.sh'
# export POST_TEST_CMD='bash /home/ubuntu/Project/scripts/smoke.sh'
# export ROLLBACK_CMD='bash /home/ubuntu/Project/scripts/rollback-prod.sh'

# ----------------------------
# Score gate retries
# ----------------------------
export SCORE_MAX_RETRIES='3'

# ----------------------------
# Score commands
# Each command must write a valid scorecard JSON to $SCORECARD_FILE.
# HARD_FLOW_GATE is also available in runtime env.
# ----------------------------
export SCORE_REQUIREMENTS_CMD='bash /home/ubuntu/Project/scripts/hardflow/score-gate.sh requirements "$SCORECARD_FILE"'
export SCORE_SOLUTION_CMD='bash /home/ubuntu/Project/scripts/hardflow/score-gate.sh solution "$SCORECARD_FILE"'
export SCORE_FRONTEND_CMD='bash /home/ubuntu/Project/scripts/hardflow/score-gate.sh frontend "$SCORECARD_FILE"'
export SCORE_BACKEND_CMD='bash /home/ubuntu/Project/scripts/hardflow/score-gate.sh backend "$SCORECARD_FILE"'
export SCORE_SECURITY_CMD='bash /home/ubuntu/Project/scripts/hardflow/score-gate.sh security "$SCORECARD_FILE"'
export SCORE_RELEASE_CMD='bash /home/ubuntu/Project/scripts/hardflow/score-gate.sh release "$SCORECARD_FILE"'
export SCORE_FINAL_CMD='bash /home/ubuntu/Project/scripts/hardflow/score-gate.sh final "$SCORECARD_FILE"'

# ----------------------------
# Improve commands
# Called when score gate does not pass and retries remain.
# ----------------------------
export IMPROVE_REQUIREMENTS_CMD='bash /home/ubuntu/Project/scripts/hardflow/improve-gate.sh requirements'
export IMPROVE_SOLUTION_CMD='bash /home/ubuntu/Project/scripts/hardflow/improve-gate.sh solution'
export IMPROVE_FRONTEND_CMD='bash /home/ubuntu/Project/scripts/hardflow/improve-gate.sh frontend'
export IMPROVE_BACKEND_CMD='bash /home/ubuntu/Project/scripts/hardflow/improve-gate.sh backend'
export IMPROVE_SECURITY_CMD='bash /home/ubuntu/Project/scripts/hardflow/improve-gate.sh security'
export IMPROVE_RELEASE_CMD='bash /home/ubuntu/Project/scripts/hardflow/improve-gate.sh release'
export IMPROVE_FINAL_CMD='bash /home/ubuntu/Project/scripts/hardflow/improve-gate.sh final'
