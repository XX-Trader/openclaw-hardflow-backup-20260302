{
  "version": "2.0.0",
  "last_updated": "2026-08-14",
  "description": "文件上下文到实际 workflow owner 的路由规则",
  "file_types": [
    {
      "category": "前端源码",
      "extensions": [".vue", ".jsx", ".tsx", ".js", ".ts", ".css", ".scss", ".sass", ".less", ".html", ".htm"],
      "agent": "frontend-dev",
      "priority": 1
    },
    {
      "category": "通用源码",
      "extensions": [".py", ".pyi", ".go", ".java", ".c", ".cc", ".cpp", ".h", ".hpp", ".cs", ".rs", ".rb", ".php", ".swift", ".kt", ".dart", ".lua"],
      "agent": "backend-dev",
      "priority": 1
    },
    {
      "category": "数据与接口",
      "extensions": [".sql", ".ddl", ".graphql", ".proto"],
      "agent": "backend-dev",
      "priority": 1
    },
    {
      "category": "部署文件",
      "extensions": ["Dockerfile", "docker-compose.yml", "docker-compose.yaml", ".dockerignore", ".tf", ".tfvars", ".k8s", ".helm"],
      "agent": "deployer",
      "priority": 1
    },
    {
      "category": "脚本与配置",
      "extensions": [".sh", ".bash", ".zsh", ".ps1", ".psm1", ".yaml", ".yml", ".json", ".toml", ".ini", ".cfg", ".conf", "Makefile", ".mk"],
      "agent": "ops-agent",
      "priority": 2
    },
    {
      "category": "文档",
      "extensions": [".md", ".markdown", ".docx", ".doc", ".pptx", ".ppt", ".pdf", ".xlsx", ".xls", ".csv"],
      "agent": "doc-writer",
      "priority": 2
    }
  ]
}
