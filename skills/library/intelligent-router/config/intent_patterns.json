{
  "version": "2.0.0",
  "updated_at": "2026-08-14",
  "description": "显式调用识别、任务提取和基于实际 Agent 的组合定义",
  "explicit_call_patterns": [
    {
      "name": "skill_call",
      "pattern": "\\[调用技能:\\s*([^\\]]+)\\]\\s*(?:执行|来处理)?\\s*(.*)",
      "type": "skill",
      "priority": 1
    },
    {
      "name": "subagent_call",
      "pattern": "\\[调用\\s*Subagent:\\s*([^\\]]+)\\]\\s*(?:执行|来处理)?\\s*(.*)",
      "type": "subagent",
      "priority": 1
    },
    {
      "name": "combo_call",
      "pattern": "\\[调用组合:\\s*([^\\]]+)\\]\\s*(?:执行|来处理)?\\s*(.*)",
      "type": "combo",
      "priority": 1
    }
  ],
  "task_extraction": {
    "fallback_keywords": ["执行", "来处理", "去处理", "帮我"],
    "max_length": 200,
    "trim_whitespace": true
  },
  "fallback_behavior": {
    "invalid_skill": "fallback_to_keyword_matching",
    "invalid_subagent": "fallback_to_keyword_matching",
    "invalid_combo": "fallback_to_keyword_matching",
    "empty_task": "use_full_user_input"
  },
  "validation": {
    "check_skill_exists": true,
    "check_subagent_exists": true,
    "check_combo_exists": true,
    "case_sensitive": false,
    "combos": {
      "需求交付组合": ["project-agent", "reviewer"],
      "全栈开发组合": ["project-agent", "backend-dev", "frontend-dev", "tester", "reviewer"],
      "代码审查组合": ["reviewer", "tester"],
      "性能分析组合": ["optimization-agent", "reviewer"]
    }
  }
}
