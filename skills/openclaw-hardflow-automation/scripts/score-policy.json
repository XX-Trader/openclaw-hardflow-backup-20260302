{
  "version": "2.0.0",
  "global": {
    "defaultMaxRetries": 3
  },
  "gates": {
    "requirements": {
      "gateId": "G0",
      "displayName": "Requirements Quality",
      "threshold": 93,
      "minEvidenceCount": 2,
      "dimensionThresholds": {
        "goal_clarity": 93,
        "scope_boundary": 92,
        "acceptance_criteria": 93,
        "constraints_coverage": 92,
        "risk_analysis": 92
      }
    },
    "solution": {
      "gateId": "G1",
      "displayName": "Solution Fitness",
      "threshold": 92,
      "minEvidenceCount": 2,
      "dimensionThresholds": {
        "fit_for_problem": 92,
        "feasibility": 92,
        "complexity_control": 91,
        "alternatives_evaluation": 90,
        "risk_mitigation": 91
      }
    },
    "frontend": {
      "gateId": "G2",
      "displayName": "Frontend Quality",
      "threshold": 92,
      "minEvidenceCount": 3,
      "dimensionThresholds": {
        "visual_design": 90,
        "information_architecture": 91,
        "interaction_quality": 90,
        "responsive_accessibility": 90,
        "code_structure": 91
      }
    },
    "backend": {
      "gateId": "G3",
      "displayName": "Backend Quality",
      "threshold": 93,
      "minEvidenceCount": 3,
      "dimensionThresholds": {
        "architecture_design": 92,
        "api_contract_quality": 92,
        "data_flow_integrity": 92,
        "maintainability": 92,
        "scalability": 91
      }
    },
    "refine": {
      "gateId": "G3.5",
      "displayName": "Iterative Refinement Quality",
      "threshold": 90,
      "minEvidenceCount": 2,
      "dimensionThresholds": {
        "error_analysis_accuracy": 90,
        "fix_effectiveness": 92,
        "regression_coverage": 91,
        "root_cause_depth": 90,
        "methodology_rigor": 89
      }
    },
    "security": {
      "gateId": "G4",
      "displayName": "Security Gate",
      "threshold": 95,
      "minEvidenceCount": 3,
      "dimensionThresholds": {
        "authn_authz": 95,
        "input_validation": 95,
        "secrets_protection": 95,
        "dependency_security": 93,
        "auditability": 93,
        "privileged_access_control": 94
      },
      "veto": {
        "enabled": true,
        "severities": ["critical", "high"],
        "resolvedStatuses": ["resolved", "mitigated", "accepted_risk"]
      }
    },
    "release": {
      "gateId": "G5",
      "displayName": "Release Readiness",
      "threshold": 92,
      "minEvidenceCount": 2,
      "dimensionThresholds": {
        "test_coverage": 92,
        "regression_result": 92,
        "deployment_reliability": 92,
        "rollback_readiness": 92,
        "observability": 90
      }
    },
    "final": {
      "gateId": "G6",
      "displayName": "Final Acceptance",
      "threshold": 93,
      "minEvidenceCount": 2,
      "dimensionThresholds": {
        "code_review_quality": 93,
        "production_smoke": 93,
        "metric_stability": 92,
        "documentation_completeness": 92,
        "deliverable_consistency": 92
      }
    }
  }
}
