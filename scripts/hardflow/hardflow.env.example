# Copy to ~/.openclaw/hardflow/hardflow.env and edit per server.
# This file is sourced by scripts/hardflow/hardflow-run.sh on every run.

# ----------------------------
# Core execution commands
# ----------------------------
export DEPLOY_CMD='bash $HOME/Project/scripts/deploy-prod.sh'
export GIT_PUSH_CMD='git -C $HOME/Project push origin HEAD:main'

# Optional:
# export DISPATCH_CMD='bash $HOME/Project/scripts/hardflow/dispatch.sh'
# export IMPLEMENT_CMD='bash $HOME/Project/scripts/hardflow/implement.sh'
# export TEST_CMD='bash $HOME/Project/scripts/test-all.sh'
# export FIX_CMD='bash $HOME/Project/scripts/hardflow/fix-failed.sh'
# export REVIEW_CMD='bash $HOME/Project/scripts/hardflow/review.sh'
# export POST_TEST_CMD='bash $HOME/Project/scripts/smoke.sh'
# export ROLLBACK_CMD='bash $HOME/Project/scripts/rollback-prod.sh'

# ----------------------------
# Score gate retries
# ----------------------------
export SCORE_MAX_RETRIES='3'

# ----------------------------
# Score commands
# Each command must write a valid scorecard JSON to $SCORECARD_FILE.
# HARD_FLOW_GATE is also available in runtime env.
# ----------------------------
export SCORE_REQUIREMENTS_CMD='bash $HOME/Project/scripts/hardflow/score-aggregator.sh requirements "$SCORECARD_FILE"'
export SCORE_SOLUTION_CMD='bash $HOME/Project/scripts/hardflow/score-aggregator.sh solution "$SCORECARD_FILE"'
export SCORE_FRONTEND_CMD='bash $HOME/Project/scripts/hardflow/score-aggregator.sh frontend "$SCORECARD_FILE"'
export SCORE_BACKEND_CMD='bash $HOME/Project/scripts/hardflow/score-aggregator.sh backend "$SCORECARD_FILE"'
export SCORE_SECURITY_CMD='bash $HOME/Project/scripts/hardflow/score-aggregator.sh security "$SCORECARD_FILE"'
export SCORE_RELEASE_CMD='bash $HOME/Project/scripts/hardflow/score-aggregator.sh release "$SCORECARD_FILE"'
export SCORE_FINAL_CMD='bash $HOME/Project/scripts/hardflow/score-aggregator.sh final "$SCORECARD_FILE"'

# ----------------------------
# Improve commands
# Called when score gate does not pass and retries remain.
# ----------------------------
export IMPROVE_REQUIREMENTS_CMD='bash $HOME/Project/scripts/hardflow/improve-evaluator.sh requirements'
export IMPROVE_SOLUTION_CMD='bash $HOME/Project/scripts/hardflow/improve-evaluator.sh solution'
export IMPROVE_FRONTEND_CMD='bash $HOME/Project/scripts/hardflow/improve-evaluator.sh frontend'
export IMPROVE_BACKEND_CMD='bash $HOME/Project/scripts/hardflow/improve-evaluator.sh backend'
export IMPROVE_SECURITY_CMD='bash $HOME/Project/scripts/hardflow/improve-evaluator.sh security'
export IMPROVE_RELEASE_CMD='bash $HOME/Project/scripts/hardflow/improve-evaluator.sh release'
export IMPROVE_FINAL_CMD='bash $HOME/Project/scripts/hardflow/improve-evaluator.sh final'

# ----------------------------
# Process optimization (scheduled)
# These checks are optional and executed by process-optimize-cron.sh.
# ----------------------------
# export HARDFLOW_PROCESS_CMD_TEST='bash $HOME/Project/scripts/test-all.sh'
# export HARDFLOW_PROCESS_CMD_REVIEW='bash $HOME/Project/scripts/hardflow/review.sh'
# export HARDFLOW_PROCESS_CMD_ACCEPTANCE='bash $HOME/Project/scripts/hardflow/check-review-test-gate.sh --stage predeploy'
# export HARDFLOW_PROCESS_CMD_POSTDEPLOY='bash $HOME/Project/scripts/hardflow/check-review-test-gate.sh --stage postdeploy'
# export HARDFLOW_PROCESS_CMD_OPS='bash $HOME/Project/scripts/ops/health-check.sh'
# export HARDFLOW_PROCESS_CMD_HYGIENE='git -C $HOME/Project diff --check'
# export HARDFLOW_PROCESS_MAX_BACKUP_FILES='8'
# export HARDFLOW_PROCESS_CMD_TIMEOUT_SEC='900'

# ----------------------------
# Hardflow safety and guardrails
# ----------------------------
# Enforce atomic task decomposition in .workflow/task.json
export HARDFLOW_REQUIRE_ATOMIC_TASK_JSON='1'

# Reset runtime context on each retry and keep .workflow/progress.txt updated
export HARDFLOW_RESET_CONTEXT_EACH_ATTEMPT='1'
# Optional custom context reset command (runs before each retry)
# export HARDFLOW_CONTEXT_RESET_CMD='bash $HOME/Project/scripts/hardflow/reset-agent-context.sh'

# Directory-level write isolation (optional; default off for non-standard project layouts)
export HARDFLOW_ENFORCE_WRITE_SCOPE='0'
# export HARDFLOW_BACKEND_WRITE_PREFIXES='api/'
# export HARDFLOW_FRONTEND_WRITE_PREFIXES='src/'

# Auto rollback to git savepoint when test loop exhausts retries
export AUTO_GIT_ROLLBACK_ON_TEST_LOOP_FAIL='1'
# Force hard reset even if repo was already dirty at classify stage (dangerous)
# export HARDFLOW_ROLLBACK_FORCE_DIRTY='1'
