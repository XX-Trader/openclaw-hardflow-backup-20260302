{
  "discovery": {
    "enabled": true,
    "scan_roots": [
      "/srv",
      "/home/ubuntu/projects",
      "/home/ubuntu"
    ],
    "max_depth": 4,
    "max_projects": 40,
    "exclude_path_tokens": [
      "/.openclaw/skills/",
      "/.openclaw/workspace-",
      "/actions-runner/_work/"
    ]
  },
  "projects": [
    {
      "id": "project-a",
      "name": "project-a",
      "path": "/srv/project-a",
      "index_dir": ".workflow/project-index-local",
      "auto_pull": true,
      "git_remote": "origin",
      "git_branch": "main",
      "integrations": [
        "binance"
      ],
      "module_globs": [
        "src/**/*.py",
        "backend/**/*.py",
        "frontend/src/**/*"
      ],
      "api_globs": [
        "**/*api*.py",
        "**/openapi*.yaml",
        "**/routes*.py"
      ],
      "script_globs": [
        "scripts/**/*",
        ".workflow/**/*.sh"
      ],
      "runtime_monitoring": {
        "enabled": true,
        "items": [
          {
            "id": "project-a-api",
            "name": "project-a-api",
            "type": "process",
            "required": true,
            "match": "uvicorn app.main:app",
            "cwd": "/srv/project-a",
            "log_paths": [
              "logs/api.log"
            ],
            "stop_command": "pkill -f 'uvicorn app.main:app'"
          },
          {
            "id": "project-a-worker",
            "name": "project-a-worker",
            "type": "service",
            "required": true,
            "service_unit": "project-a-worker.service",
            "log_paths": [
              "/var/log/project-a-worker.log"
            ],
            "stop_command": "systemctl stop project-a-worker.service"
          }
        ]
      },
      "doc_sources": [
        {
          "id": "project-a-api-reference",
          "url": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/general-api-information",
          "category": "api-doc",
          "tags": [
            "project",
            "api",
            "official",
            "binance"
          ],
          "enabled": true,
          "browser_fallback": true,
          "min_interval_minutes": 180
        }
      ]
    },
    {
      "id": "project-b",
      "name": "project-b",
      "path": "/srv/project-b",
      "index_dir": ".workflow/project-index-local",
      "auto_pull": true,
      "git_remote": "origin",
      "git_branch": "master"
    }
  ]
}
