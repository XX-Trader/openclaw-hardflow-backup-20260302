{
  "projects": [
    {
      "id": "project-a",
      "name": "project-a",
      "path": "/srv/project-a",
      "index_dir": ".workflow/project-index-local",
      "auto_pull": true,
      "git_remote": "origin",
      "git_branch": "main",
      "integrations": [
        "binance"
      ],
      "module_globs": [
        "src/**/*.py",
        "backend/**/*.py",
        "frontend/src/**/*"
      ],
      "api_globs": [
        "**/*api*.py",
        "**/openapi*.yaml",
        "**/routes*.py"
      ],
      "script_globs": [
        "scripts/**/*",
        ".workflow/**/*.sh"
      ],
      "doc_sources": [
        {
          "id": "project-a-api-reference",
          "url": "https://developers.binance.com/docs/binance-spot-api-docs/rest-api/general-api-information",
          "category": "api-doc",
          "tags": [
            "project",
            "api",
            "official",
            "binance"
          ],
          "enabled": true,
          "browser_fallback": true,
          "min_interval_minutes": 180
        }
      ]
    },
    {
      "id": "project-b",
      "name": "project-b",
      "path": "/srv/project-b",
      "index_dir": ".workflow/project-index-local",
      "auto_pull": true,
      "git_remote": "origin",
      "git_branch": "master"
    }
  ]
}
