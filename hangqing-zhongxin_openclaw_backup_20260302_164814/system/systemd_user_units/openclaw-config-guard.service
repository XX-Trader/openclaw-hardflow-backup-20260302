[Unit]
Description=OpenClaw Config Guard (Healthcheck + Auto Rollback)

[Service]
Type=oneshot
ExecStart=/bin/bash -lc '/home/ubuntu/.openclaw/workflows/openclaw-ops/openclaw_healthcheck.sh || /home/ubuntu/.openclaw/workflows/openclaw-ops/openclaw_config_apply_with_rollback.sh --rollback-latest'
WorkingDirectory=/home/ubuntu
