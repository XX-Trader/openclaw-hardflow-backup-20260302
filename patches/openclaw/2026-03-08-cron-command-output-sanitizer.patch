 };
 
+const COMMAND_ONLY_MESSAGE_MARKERS = [
+  "run command only:",
+  "return exactly raw stdout/stderr text from the command",
+  "仅用命令执行",
+  "将命令输出原样作为唯一回复",
+];
+
+const COMMAND_RUNNER_CHATTER_RE =
+  /^(let's|okay[,!]?|now let's|i(?:'|’)ll|i will|running\b|starting\b|let me\b)/i;
+const COMMAND_RUNNER_WRAPUP_RE =
+  /^(backup completed successfully!?|here(?:'|’)s the summary\b|##\s*summary\b|summary\b|okay, the .*? is now complete!?|let(?:'|’)s clarify\b)/i;
+const COMMAND_OUTPUT_FIELD_LINE_RE = /(^|\n)-\s*[\w\u4e00-\u9fff._-]{1,40}\s*:/;
+const COMMAND_OUTPUT_ERROR_RE =
+  /^(traceback\b|error:|nameerror:|typeerror:|valueerror:|usage:|python\d?: can't open file|bash:|sh:|fatal:|module not found\b|modulenotfounderror:|syntaxerror:)/i;
+
+function normalizeText(value: string | undefined) {
+  return (value ?? "").trim();
+}
+
+function isLikelyNarrativeCommandRunnerText(text: string) {
+  const clean = normalizeText(text);
+  if (!clean) {
+    return false;
+  }
+  return COMMAND_RUNNER_CHATTER_RE.test(clean) || COMMAND_RUNNER_WRAPUP_RE.test(clean);
+}
+
+function looksLikeRawCommandOutput(text: string) {
+  const clean = normalizeText(text);
+  if (!clean) {
+    return false;
+  }
+  if (clean.toUpperCase() === "NO_REPLY") {
+    return true;
+  }
+  if (clean.startsWith("{") || clean.startsWith("```") || clean.startsWith("#")) {
+    return true;
+  }
+  if (COMMAND_OUTPUT_ERROR_RE.test(clean)) {
+    return true;
+  }
+  if (COMMAND_OUTPUT_FIELD_LINE_RE.test(clean)) {
+    return true;
+  }
+  return false;
+}
+
+export function isCommandOnlyAgentTurnMessage(message: string | undefined) {
+  const clean = normalizeText(message).toLowerCase();
+  if (!clean) {
+    return false;
+  }
+  const englishPrompt =
+    clean.includes("run command only:") &&
+    clean.includes("return exactly raw stdout/stderr text from the command");
+  const chinesePrompt = clean.includes("仅用命令执行") && clean.includes("将命令输出原样作为唯一回复");
+  const genericPrompt = COMMAND_ONLY_MESSAGE_MARKERS.filter((marker) => clean.includes(marker)).length >= 2;
+  return englishPrompt || chinesePrompt || genericPrompt;
+}
+
+export function pickCommandRunnerTextFromPayloads(
+  payloads: Array<{ text?: string | undefined; isError?: boolean }>,
+) {
+  const passes: Array<(payload: { text?: string | undefined; isError?: boolean }) => boolean> = [
+    (payload) => payload?.isError !== true,
+    () => true,
+  ];
+  for (const allow of passes) {
+    for (let i = payloads.length - 1; i >= 0; i--) {
+      const payload = payloads[i];
+      if (!allow(payload)) {
+        continue;
+      }
+      const clean = normalizeText(payload?.text);
+      if (!clean || isLikelyNarrativeCommandRunnerText(clean)) {
+        continue;
+      }
+      if (looksLikeRawCommandOutput(clean)) {
+        return clean;
+      }
+    }
+  }
+  return undefined;
+}
+
 export function pickSummaryFromOutput(text: string | undefined) {
-  const clean = (text ?? "").trim();
+  const clean = normalizeText(text);
   if (!clean) {
     return undefined;
   }
