+import { describe, expect, it } from "vitest";
+import {
+  makeIsolatedAgentTurnJob,
+  makeIsolatedAgentTurnParams,
+  setupRunCronIsolatedAgentTurnSuite,
+} from "./run.suite-helpers.js";
+import {
+  isCommandOnlyAgentTurnMessageMock,
+  loadRunCronIsolatedAgentTurn,
+  pickCommandRunnerTextFromPayloadsMock,
+} from "./run.test-harness.js";
+
+const runCronIsolatedAgentTurn = await loadRunCronIsolatedAgentTurn();
+
+describe("runCronIsolatedAgentTurn - command-only contract", () => {
+  setupRunCronIsolatedAgentTurnSuite();
+
+  it("treats narration-only command-runner replies as errors instead of deliverable output", async () => {
+    isCommandOnlyAgentTurnMessageMock.mockReturnValue(true);
+    pickCommandRunnerTextFromPayloadsMock.mockReturnValue(undefined);
+
+    const result = await runCronIsolatedAgentTurn(
+      makeIsolatedAgentTurnParams({
+        job: makeIsolatedAgentTurnJob({
+          payload: {
+            kind: "agentTurn",
+            message: "You are scheduled runner. Run command only:\npython3 /tmp/job.py",
+          },
+        }),
+      }),
+    );
+
+    expect(result.status).toBe("error");
+    expect(result.error).toBe("cron command-only job returned non-command text");
+    expect(result.summary).toBeUndefined();
+    expect(result.outputText).toBeUndefined();
+  });
+
+  it("keeps trusted command output when helper resolved a raw payload", async () => {
+    isCommandOnlyAgentTurnMessageMock.mockReturnValue(true);
+    pickCommandRunnerTextFromPayloadsMock.mockReturnValue(
+      "# local-git-backup\n- task: cron:ops-local-openclaw-git-backup",
+    );
+
+    const result = await runCronIsolatedAgentTurn(
+      makeIsolatedAgentTurnParams({
+        job: makeIsolatedAgentTurnJob({
+          payload: {
+            kind: "agentTurn",
+            message: "You are scheduled runner. Run command only:\npython3 /tmp/job.py",
+          },
+        }),
+      }),
+    );
+
+    expect(result.status).toBe("ok");
+    expect(result.summary).toBe("summary");
+    expect(result.outputText).toContain("cron:ops-local-openclaw-git-backup");
+  });
+});
