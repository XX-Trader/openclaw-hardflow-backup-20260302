{
  "hooks": [
    {
      "name": "boot-md",
      "enabled": true,
      "classification": "builtin",
      "events": [
        "gateway:startup"
      ],
      "has_doc": false
    },
    {
      "name": "bootstrap-extra-files",
      "enabled": true,
      "classification": "builtin",
      "events": [
        "agent:bootstrap"
      ],
      "has_doc": false
    },
    {
      "name": "command-logger",
      "enabled": true,
      "classification": "builtin",
      "events": [
        "command"
      ],
      "has_doc": false
    },
    {
      "name": "hardflow-audit",
      "enabled": true,
      "classification": "custom",
      "events": [
        "command"
      ],
      "has_doc": true
    },
    {
      "name": "hardflow-command-guard",
      "enabled": true,
      "classification": "custom",
      "events": [
        "command:new",
        "command:reset"
      ],
      "has_doc": true
    },
    {
      "name": "hardflow-policy-enforcer",
      "enabled": true,
      "classification": "custom",
      "events": [
        "command:new",
        "command:reset",
        "command:stop"
      ],
      "has_doc": true
    },
    {
      "name": "hardflow-stop-gate-reminder",
      "enabled": true,
      "classification": "custom",
      "events": [
        "command:stop"
      ],
      "has_doc": true
    },
    {
      "name": "session-memory",
      "enabled": true,
      "classification": "builtin",
      "events": [
        "command:new",
        "command:reset"
      ],
      "has_doc": false
    }
  ],
  "events": {
    "agent:bootstrap": [
      "bootstrap-extra-files"
    ],
    "command": [
      "command-logger",
      "hardflow-audit"
    ],
    "command:new": [
      "hardflow-command-guard",
      "hardflow-policy-enforcer",
      "session-memory"
    ],
    "command:reset": [
      "hardflow-command-guard",
      "hardflow-policy-enforcer",
      "session-memory"
    ],
    "command:stop": [
      "hardflow-policy-enforcer",
      "hardflow-stop-gate-reminder"
    ],
    "gateway:startup": [
      "boot-md"
    ]
  }
}
